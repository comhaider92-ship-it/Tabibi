{
  "name": "tabibi-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "check:build-config": "node scripts/check-build-config.mjs preview",
    "check:build-config:production": "node scripts/check-build-config.mjs production",
    "build:android:preview:checked": "npm run check:build-config && eas build --platform android --profile preview",
    "build:android:production:checked": "npm run check:build-config:production && eas build --platform android --profile production"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~52.0.0",
    "expo-status-bar": "~2.0.1",
    "react": "18.3.1",
    "react-native": "0.76.5",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "expo-secure-store": "~14.0.1",
    "expo-device": "~7.0.3",
    "expo-notifications": "~0.29.14",
    "expo-file-system": "~18.0.12",
    "expo-sharing": "~13.0.1",
    "expo-document-picker": "~13.0.3",
    "expo-asset": "~11.0.5"
  },
  "devDependencies": {
    "@types/react": "~18.3.12",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
