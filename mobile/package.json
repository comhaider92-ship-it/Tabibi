{
  "name": "tabibi-mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo/AppEntry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "build:android:preview": "eas build --platform android --profile preview",
    "build:android:production": "eas build --platform android --profile production",
    "check:build-config": "node scripts/check-build-config.mjs preview",
    "check:build-config:production": "node scripts/check-build-config.mjs production",
    "build:android:preview:checked": "npm run check:build-config && eas build --platform android --profile preview",
    "build:android:production:checked": "npm run check:build-config:production && eas build --platform android --profile production",
    "postinstall": "node scripts/patch-metro-image-size.mjs"
  },
  "dependencies": {
    "@react-navigation/native": "^7.0.14",
    "@react-navigation/native-stack": "^7.2.0",
    "expo": "~55.0.0",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.24",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "typescript": "~5.9.2"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "tar": "7.5.21",
    "postcss": "8.5.33",
    "image-size": "2.1.0",
    "@xmldom/xmldom": "0.9.12"
  }
}
