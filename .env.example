NODE_ENV=production
PORT=3000
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=postgres
DATABASE_PASSWORD=change_me
DATABASE_NAME=tabibi
JWT_SECRET=replace_with_a_long_random_secret_at_least_32_chars
JWT_EXPIRES_IN=30m
OWNER_EMAIL=owner@example.com
OWNER_PHONE=
OWNER_PASSWORD=replace_this_owner_password

# Firebase Cloud Messaging (FCM); provide the service-account JSON as one line.
FIREBASE_SERVICE_ACCOUNT_JSON=

# OTP email delivery (SMTP). Configure with your email provider.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# OTP SMS provider adapter. Endpoint must accept POST JSON {to,message,sender}
# with Authorization: Bearer <SMS_API_TOKEN> and return HTTP 2xx on acceptance.
SMS_API_URL=
SMS_API_TOKEN=
SMS_SENDER_ID=

# Private file storage; keep outside any public/static web root
UPLOADS_DIRECTORY=./private-uploads
# Increase reverse-proxy request body limit to at least 14 MB for base64 uploads

# Publicly reachable API base URL used to create prescription verification QR codes
PUBLIC_API_BASE_URL=https://YOUR_REAL_API_DOMAIN/api/v1
